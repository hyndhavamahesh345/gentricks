rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Community Members (Public signup form)
    match /community_members/{memberId} {
      allow create: if request.resource.data.consent == true;
      allow read, update, delete: if false; // Only accessible by admin/dashboard
    }

    // 2. Newsletter Subscribers
    match /newsletter_subscribers/{subscriberId} {
      allow create: if request.resource.data.email != null;
      allow read, update, delete: if false;
    }

    // 3. Idea Submissions (LaunchPad entries)
    match /idea_submissions/{submissionId} {
      allow create: if request.resource.data.contact_email != null;
      allow read, update, delete: if false;
    }

    // 4. Public Content: Profiles, Projects, Startups, Events, Opportunities
    match /profiles/{profileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /startups/{startupId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /opportunities/{opportunityId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /media_episodes/{episodeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
